[Unit]
Description=Persistty Web service
After=network.target

[Service]
Type=simple
# 将 developer 替换为现有的非 root 开发账号。
User=developer
Group=developer
WorkingDirectory=/var/lib/persistty
ExecStart=/usr/local/bin/persistty serve --config /etc/persistty/config.yaml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/persistty
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
