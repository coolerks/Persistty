{
  "name": "persistty-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "node scripts/verify-font.mjs && node scripts/collect-licenses.mjs && tsc --noEmit && vite build",
    "prepare:assets": "node scripts/generate-language-metadata.mjs && node scripts/generate-material-icons.mjs",
    "predev": "npm run prepare:assets",
    "prelint": "npm run prepare:assets",
    "pretypecheck": "npm run prepare:assets",
    "pretest": "npm run prepare:assets",
    "pretest:e2e": "npm run prepare:assets",
    "prebuild": "npm run prepare:assets"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@monaco-editor/react": "4.7.0",
    "@noble/hashes": "^2.4.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "1.48.0",
    "monaco-editor": "0.57.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "4.14.1",
    "react-router": "8.4.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "jsdom": "30.1.1",
    "material-icon-theme": "5.38.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
